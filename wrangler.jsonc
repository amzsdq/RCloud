{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rcloud",
  "main": "src/index.js",
  "compatibility_date": "2026-09-22",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "RUNTIME_STATE",
        "class_name": "RuntimeState"
      }
    ]
  },
  "exports": {
    "RuntimeState": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
